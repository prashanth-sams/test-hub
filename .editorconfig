# https://editorconfig.org — keeps whitespace consistent across editors so a
# diff never contains an invisible re-indent. The Python settings mirror the
# ruff configuration in pyproject.toml; if you change one, change both.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,css,html,json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
